APP_ENV=production
PUBLIC_BASE_URL=https://estranged-evergreen-hatchet.ngrok-free.dev/github
GPT_ACTION_SECRET=replace-with-a-long-random-secret

# Optional per-user authorization. GPT_ACTION_SECRET remains a legacy admin token.
# Prefer token_sha256 over plaintext token for real deployments.
# AUTH_USERS_JSON={"users":[{"username":"alice","token_sha256":"<sha256-of-user-token>","roles":["reader"],"repos":["owner/repo"]}]}
AUTH_USERS_JSON=

# GitHub auth: use PAT for MVP, GitHub App for production/team use.
GITHUB_AUTH_MODE=pat
GITHUB_TOKEN=replace-with-your-github-personal-access-token
GITHUB_GIT_USERNAME=octocat
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10

ALLOW_ALL_REPOS=true
READ_BRANCH_ALLOWLIST=main,master,develop,gpt/*
BASE_BRANCH_ALLOWLIST=main,master,develop
WRITE_BRANCH_PREFIX=gpt/
DEFAULT_BASE_BRANCH=main

ALLOW_WORKFLOW_EDIT=true
ALLOW_DELETE_FILES=true

MAX_LOG_BYTES=80000
MAX_LOG_LINES=500
MAX_BLOB_READ_BYTES=2MB

WORKSPACE_ROOT=./data/workspaces
WORKSPACE_MIRROR_ROOT=./data/mirrors
WORKSPACE_DEFAULT_TIMEOUT_SECONDS=60
WORKSPACE_MAX_TIMEOUT_SECONDS=300
WORKSPACE_MAX_OUTPUT_BYTES=80000
WORKSPACE_MAX_DIFF_BYTES=200000
WORKSPACE_MAX_PATCH_BYTES=200000
WORKSPACE_MAX_WRITE_BYTES=200000
WORKSPACE_MAX_CHANGED_FILES=200
WORKSPACE_TTL_HOURS=24
WORKSPACE_MAX_COUNT=50
WORKSPACE_ALLOW_NETWORK=true
WORKSPACE_SHELL=pwsh
WORKSPACE_GIT_USER_NAME=gpt-actions-gateway
WORKSPACE_GIT_USER_EMAIL=gpt-actions-gateway@users.noreply.github.com

RATE_LIMIT_PER_MINUTE=60
AUDIT_DB_URL=sqlite:///./data/audit.db
REQUEST_TIMEOUT_SECONDS=30
