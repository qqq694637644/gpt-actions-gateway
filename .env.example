APP_ENV=production
PUBLIC_BASE_URL=https://gateway.example.com
GPT_ACTION_SECRET=replace-with-a-long-random-secret

# GitHub auth: use PAT for MVP, GitHub App for production/team use.
GITHUB_AUTH_MODE=pat
GITHUB_TOKEN=github_pat_xxx
# GITHUB_AUTH_MODE=github_app
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_INSTALLATION_ID=12345678
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_USE_ENV_PROXY=false

ALLOWED_REPOS=owner/project-a,owner/project-b
ALLOW_ALL_REPOS=false
READ_BRANCH_ALLOWLIST=main,master,develop,gpt/*
BASE_BRANCH_ALLOWLIST=main,master,develop
WRITE_BRANCH_PREFIX=gpt/
DEFAULT_BASE_BRANCH=main

MAX_FILE_SIZE=200KB
MAX_TOTAL_READ_SIZE=500KB
MAX_TOTAL_COMMIT_SIZE=1MB
MAX_FILES_PER_COMMIT=20
MAX_LOG_BYTES=80000
MAX_LOG_LINES=500
MAX_BLOB_READ_BYTES=2MB

ALLOW_WORKFLOW_EDIT=false
ALLOW_DELETE_FILES=false
ALLOW_RERUN_CI=false
ALLOW_AUTO_MERGE=false

RATE_LIMIT_PER_MINUTE=60
AUDIT_DB_URL=sqlite:///./audit.db
REQUEST_TIMEOUT_SECONDS=30
